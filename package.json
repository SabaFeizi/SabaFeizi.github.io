{
  "name": "saba-famil-feizi-website",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Saba Famil Feizi \u2014 static site built with Eleventy, content managed via Sveltia CMS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "eleventy --serve --port=8080",
    "validate": "node scripts/validate-content.mjs",
    "build": "eleventy",
    "placeholders": "node scripts/make-placeholders.mjs",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.0.0",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@sveltia/cms": "0.233.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "ionicons": "^8.1.0",
    "markdown-it": "^15.0.3",
    "sharp": "^0.35.5"
  }
}
