{
  "name": "saba-famil-feizi-website",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Saba Famil Feizi — static site built with Eleventy, content managed via Sveltia CMS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "eleventy --serve --port=8080",
