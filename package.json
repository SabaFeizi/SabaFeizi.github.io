    "@11ty/eleventy-img": "^7.0.0",
    "@fontsource/poppins": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "ionicons": "^8.1.0",
    "markdown-it": "^15.0.3",
    "sharp": "^0.35.5"
  }
}
