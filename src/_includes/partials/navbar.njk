{#- Tab navigation. On the home page the tabs switch in place (hash routing);
    on a blog post page they link back to the home page tabs. -#}
{%- set navPages = [
  { id: "about", label: "About" },
  { id: "resume", label: "Resume" },
  { id: "certificates", label: "Certificates" },
  { id: "blog", label: "Blog" }
] %}
{%- set activeTab = "blog" if title else "about" %}
<nav class="navbar" aria-label="Sections">
  <ul class="navbar-list">
    {% for p in navPages %}
    <li class="navbar-item">
      <a href="{{ '/' if title }}#{{ p.id }}" class="navbar-link{% if p.id == activeTab %} active{% endif %}" data-nav-link="{{ p.id }}"{% if p.id == activeTab %} aria-current="page"{% endif %}>{{ p.label }}</a>
    </li>
    {% endfor %}
  </ul>
</nav>
