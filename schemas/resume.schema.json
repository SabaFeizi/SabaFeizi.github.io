{
  "$id": "resume.schema.json",
  "type": "object",
  "required": [
    "heading",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "heading": {
      "$ref": "defs.schema.json#/$defs/nonEmpty"
    },
    "sections": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "title",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "defs.schema.json#/$defs/nonEmpty"
          },
          "icon": {
            "$ref": "defs.schema.json#/$defs/icon"
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "$ref": "defs.schema.json#/$defs/nonEmpty"
                },
                "period": {
                  "type": "string",
                  "maxLength": 100
                },
                "body": {
                  "type": "string",
                  "maxLength": 5000
                },
                "visible": {
                  "type": "boolean"
                }
              }
            }
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
