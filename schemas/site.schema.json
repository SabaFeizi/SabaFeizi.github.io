{
  "$id": "site.schema.json",
  "type": "object",
  "required": [
    "url",
    "name",
    "name_lines",
    "title_lines",
    "avatar",
    "email",
    "socials",
    "seo"
  ],
  "additionalProperties": false,
  "properties": {
    "url": {
      "$ref": "defs.schema.json#/$defs/siteUrl"
    },
    "name": {
      "$ref": "defs.schema.json#/$defs/nonEmpty"
    },
    "name_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "defs.schema.json#/$defs/nonEmpty"
      }
    },
    "title_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "defs.schema.json#/$defs/nonEmpty"
      }
    },
    "avatar": {
      "$ref": "defs.schema.json#/$defs/upload"
    },
    "avatar_alt": {
      "type": "string",
      "maxLength": 200
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "pattern": "^[0-9+()\\s.-]{0,30}$"
    },
    "location": {
      "type": "string",
      "maxLength": 120
    },
    "socials": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "label",
          "icon",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "defs.schema.json#/$defs/nonEmpty"
          },
          "icon": {
            "$ref": "defs.schema.json#/$defs/icon"
          },
          "url": {
            "$ref": "defs.schema.json#/$defs/safeUrl"
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "defs.schema.json#/$defs/nonEmpty"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "share_image": {
          "$ref": "defs.schema.json#/$defs/optionalUpload"
        }
      }
    },
    "show_email": {
      "type": "boolean"
    },
    "show_phone": {
      "type": "boolean"
    },
    "show_location": {
      "type": "boolean"
    },
    "show_socials": {
      "type": "boolean"
    },
    "tabs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resume": {
          "type": "boolean"
        },
        "certificates": {
          "type": "boolean"
        },
        "blog": {
          "type": "boolean"
        }
      }
    },
    "protect_avatar": {
      "type": "boolean"
    }
  }
}
